<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_travel_umroh" model="ir.module.category">
        <field name="name">Travel Umroh</field>
        <field name="description">Kelola konfigurasi dan operasional Travel Umroh.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_travel_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="category_id" ref="module_category_travel_umroh"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_travel_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="category_id" ref="module_category_travel_umroh"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_travel_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_travel_umroh"/>
        <field name="implied_ids" eval="[(4, ref('group_travel_staff')), (4, ref('group_travel_finance'))]"/>
    </record>

    <record id="rule_travel_booking_all_roles" model="ir.rule">
        <field name="name">Travel roles: all travel bookings</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('is_travel_booking', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_travel_staff')), (4, ref('group_travel_finance'))]"/>
    </record>

    <record id="rule_travel_booking_line_all_roles" model="ir.rule">
        <field name="name">Travel roles: all travel booking lines</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.is_travel_booking', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_travel_staff')), (4, ref('group_travel_finance'))]"/>
    </record>
</odoo>
