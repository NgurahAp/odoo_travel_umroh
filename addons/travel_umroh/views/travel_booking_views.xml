<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_travel" model="ir.ui.view">
        <field name="name">sale.order.form.travel.umroh</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_refresh_travel_prices" type="object" string="Refresh Harga" invisible="not is_travel_booking or state not in ('draft', 'sent')"/>
                <button name="action_open_travel_cancel_wizard" type="object" string="Batalkan setelah DP" class="btn-secondary" groups="travel_umroh.group_travel_manager" invisible="not is_travel_booking or state != 'sale' or not travel_requires_manager_cancel"/>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible" add="is_travel_booking and travel_requires_manager_cancel" separator=" or "/>
            </xpath>
            <field name="partner_id" position="attributes">
                <attribute name="invisible">is_travel_booking</attribute>
            </field>
            <field name="partner_id" position="before">
                <field name="is_travel_booking" invisible="1"/>
                <field name="partner_id"
                       string="Pemesan / Penanggung Jawab"
                       widget="res_partner_many2one"
                       context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                       placeholder="Pilih kontak pemesan atau buat kontak baru..."
                       readonly="state in ['cancel', 'sale']"
                       invisible="not is_travel_booking"/>
            </field>
            <field name="partner_id" position="after">
                <field name="can_edit_travel_participants" invisible="1"/>
                <field name="can_override_travel_price" invisible="1"/>
                <field name="travel_requires_manager_cancel" invisible="1"/>
                <field name="departure_id" domain="[('state', '=', 'open'), ('active', '=', True), ('is_full', '=', False)]" invisible="not is_travel_booking" readonly="state not in ('draft', 'sent')" options="{'no_create': True}"/>
                <field name="travel_package_id" invisible="not is_travel_booking" readonly="1"/>
                <field name="travel_payment_state" widget="badge" invisible="not is_travel_booking" readonly="1"/>
                <field name="travel_state" widget="badge" invisible="not is_travel_booking" readonly="1"/>
                <field name="seat_reserved" invisible="not is_travel_booking" readonly="1"/>
                <field name="seat_reserved_at" invisible="not is_travel_booking" readonly="1"/>
            </field>
            <xpath expr="//page[@name='order_lines']" position="attributes">
                <attribute name="invisible">is_travel_booking</attribute>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Participant" name="travel_participants" invisible="not is_travel_booking">
                    <field name="participant_ids" readonly="not can_edit_travel_participants">
                        <list editable="bottom">
                            <field name="can_override_price" column_invisible="1"/>
                            <field name="jamaah_id"/>
                            <field name="room_type"/>
                            <field name="unit_price" readonly="not can_override_price"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="sale_line_id" readonly="1" optional="hide"/>
                        </list>
                        <form string="Participant Booking">
                            <group>
                                <field name="can_override_price" invisible="1"/>
                                <field name="jamaah_id"/>
                                <field name="room_type"/>
                                <field name="unit_price" readonly="not can_override_price"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="sale_line_id" readonly="1"/>
                            </group>
                        </form>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_total" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_travel_booking" model="ir.actions.act_window">
        <field name="name">Booking</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_travel_booking', '=', True)]</field>
        <field name="context">{'default_is_travel_booking': True}</field>
    </record>
</odoo>
