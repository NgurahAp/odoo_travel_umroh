<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_travel_booking_cancel_wizard_form" model="ir.ui.view">
        <field name="name">travel.booking.cancel.wizard.form</field>
        <field name="model">travel.booking.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Batalkan Booking setelah DP">
                <group>
                    <field name="order_id"/>
                    <field name="reason" placeholder="Tuliskan alasan pembatalan..."/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" type="object" string="Batalkan Booking" class="btn-primary"/>
                    <button string="Tutup" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_travel_booking_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Batalkan Booking setelah DP</field>
        <field name="res_model">travel.booking.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_travel_booking_cancel_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
