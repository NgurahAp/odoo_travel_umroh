<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_travel_package_list" model="ir.ui.view">
        <field name="name">travel.package.list</field>
        <field name="model">travel.package</field>
        <field name="arch" type="xml">
            <list string="Paket Umroh">
                <field name="code"/>
                <field name="name"/>
                <field name="product_id"/>
                <field name="duration_days"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_travel_package_form" model="ir.ui.view">
        <field name="name">travel.package.form</field>
        <field name="model">travel.package</field>
        <field name="arch" type="xml">
            <form string="Paket Umroh">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Contoh: Umroh Reguler 9 Hari"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="Contoh: REG-09"/>
                            <field name="product_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="duration_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deskripsi dan Fasilitas" name="description">
                            <field name="description" placeholder="Tuliskan deskripsi paket dan fasilitas umum..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_travel_package_search" model="ir.ui.view">
        <field name="name">travel.package.search</field>
        <field name="model">travel.package</field>
        <field name="arch" type="xml">
            <search string="Cari Paket Umroh">
                <field name="name"/>
                <field name="code"/>
                <field name="product_id"/>
                <separator/>
                <filter name="archived" string="Diarsipkan" domain="[('active', '=', False)]" context="{'active_test': False}"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_product" string="Produk" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_travel_package" model="ir.actions.act_window">
        <field name="name">Paket Umroh</field>
        <field name="res_model">travel.package</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_travel_package_search"/>
    </record>
</odoo>
