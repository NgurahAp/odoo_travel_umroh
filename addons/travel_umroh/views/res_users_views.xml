<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_travel_umroh_role" model="ir.ui.view">
        <field name="name">res.users.form.travel.umroh.role</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">15</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']/field[@name='groups_id']" position="before">
                <group string="Travel Umroh" groups="base.group_system">
                    <field name="travel_umroh_role" placeholder="Select one role"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
